---
import { adSlotDataset, type AdPlacement } from '../lib/monetization';

interface Props {
	placement: AdPlacement;
}

const { placement } = Astro.props;
const dataset = adSlotDataset(placement);
---

{dataset && (
	<div data-ad-slot={dataset['data-ad-slot']}>
		<script
			async
			data-cfasync="false"
			src="https://pl31055290.profitableratecpmnetwork.com/dcd3a104a99f11ab577ca98dd180ec29/invoke.js"
		></script>
		<div id="container-dcd3a104a99f11ab577ca98dd180ec29"></div>
	</div>
)}
