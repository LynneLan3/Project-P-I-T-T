---
import {
	ADSTERRA_CONTAINER_ID,
	ADSTERRA_INVOKE_SRC,
	adSlotDataset,
	type AdPlacement,
} from '../lib/monetization';

interface Props {
	placement: AdPlacement;
}

const { placement } = Astro.props;
const dataset = adSlotDataset(placement);
---

{dataset && (
	<div data-ad-slot={dataset['data-ad-slot']}>
		<script
			async
			data-cfasync="false"
			src={ADSTERRA_INVOKE_SRC}
		></script>
		<div id={ADSTERRA_CONTAINER_ID}></div>
	</div>
)}
