---
/**
 * Formal Experience Homepage (V2.2-E1) — rendered at `/{hubPath}/`.
 *
 * Replaces the legacy GamePortal presentation on the splash entry. Every
 * section is data-driven from existing runtime config (`game`, `game.routes`,
 * `game.portal`) and the existing docs content collection. No new Homepage
 * schema. Sections are omitted (never placeholder-filled) when their data is
 * absent.
 *
 * Section order:
 *   Hero → Popular Questions → Status Strip → Choose Your Route → Start Here →
 *   Featured → Field Notes → Recently Updated → Evidence → About (id="about")
 */
import { Image } from 'astro:assets';
import AdSlot from '../AdSlot.astro';
import { game } from '../../config/game';
import { resolveGameAsset } from '../../lib/assets';
import { getGuides, guideHref, categoryOf } from '../../lib/guides';
import {
	deriveRecentViews,
	fieldNotesFrom,
	findFeaturedGuide,
	hasGuideCover,
} from '../../lib/experience-homepage';
import { experienceNav } from '../../lib/experience-nav';
import {
	formatReleaseDateValue,
	formatReleaseFact,
	formatUiDate,
	releaseStatusLabel,
	ui,
} from '../../lib/ui';
import ExperienceRouteShowcase from './ExperienceRouteShowcase.astro';
import RouteTopicCard from './routes/RouteTopicCard.astro';

const t = ui();
const guides = await getGuides();
const { guidesHref } = experienceNav();

/* ── Hero ── */
const heroImage = resolveGameAsset(game.heroImage, 'game.heroImage');
const heroPosition = game.heroPosition ?? 'center';

/* ── Start Here ── */
type StartHereView = {
	title: string;
	description: string;
	href: string;
	label?: string;
	badge?: string;
};

const configuredStartHere = game.portal?.startHere;
const startHere: StartHereView[] = configuredStartHere?.length
	? configuredStartHere.slice(0, 4).map((item) => ({
			title: item.title,
			description: item.description,
			href: item.href,
			label: item.label,
			badge: item.badge,
		}))
	: [];

/* ── Hero CTAs ── */
const configuredPrimary = game.portal?.primaryCta;
const primaryCta =
	configuredPrimary && !configuredPrimary.href.startsWith('#')
		? { label: configuredPrimary.label, href: configuredPrimary.href }
		: startHere[0]
			? { label: configuredPrimary?.label ?? t.startHere, href: startHere[0].href }
			: undefined;
const configuredSecondary = game.portal?.secondaryCta;
const secondaryCta =
	configuredSecondary && !configuredSecondary.href.startsWith('#')
		? { label: configuredSecondary.label, href: configuredSecondary.href }
		: { label: configuredSecondary?.label ?? t.browseGuides, href: guidesHref };

/* ── Status Strip ── */
const curatedRecent = game.portal?.recentUpdates;
const showRecentlyUpdated = game.portal?.showRecentlyUpdated !== false;
const maxRecent = Math.min(game.portal?.maxRecent ?? 3, 4);
const recentlyUpdated = !showRecentlyUpdated
	? []
	: curatedRecent?.length
		? curatedRecent.slice(0, maxRecent).map((item) => ({
				title: item.title,
				href: item.href,
				date: new Date(item.date),
				changeSummary: item.changeSummary,
				tag: item.tag,
			}))
		: deriveRecentViews(guides, maxRecent);

const configuredStatus = game.portal?.statusItems;
const derivedStatus = [
	{
		label: releaseStatusLabel(game.releaseStatus),
		value: formatReleaseDateValue(game.releaseDate) ?? '',
	},
	{ label: t.platforms, value: game.platforms.filter(Boolean).join(' / ') },
	{ label: t.developer, value: game.developer },
	recentlyUpdated[0]
		? { label: t.updated, value: formatUiDate(recentlyUpdated[0].date) }
		: { label: t.updated, value: '' },
];
const statusItems = (
	configuredStatus
		? configuredStatus.map((item) => ({ label: item.label, value: item.value }))
		: derivedStatus
)
	.filter((item) => item.label.trim() && item.value.trim())
	.slice(0, 4);

/* ── Choose Your Route ── */
const routes = game.routes ?? [];
const singleRoute = routes.length === 1 ? routes[0] : undefined;
const singleRouteStartGuides = singleRoute?.pages ?? [];

/* ── Popular Questions ── */
const popularQuestions = (game.portal?.popularQuestions ?? []).map((question) =>
	question.label === 'What is my elevator keypad code?'
		? { ...question, href: '/elevator-code/' }
		: question,
);

/* ── Featured ── */
const featured = findFeaturedGuide(guides);
const featuredHref = featured ? guideHref(featured) : undefined;
const featuredHasCover = Boolean(featured?.data.cover);
const featuredEyebrow =
	featured?.data.eyebrow ?? (featured ? categoryOf(featured)?.label : undefined) ?? t.featuredEyebrow;

/* ── Field Notes ── */
const startHereHrefs = new Set(startHere.map((item) => item.href));
const fieldNotes = fieldNotesFrom(guides, {
	excludeHrefs: startHereHrefs,
	excludeFeaturedHref: featuredHref,
	limit: 3,
});
const firstNoteWithCover = fieldNotes.find(hasGuideCover);

/* ── Evidence ── */
const evidenceConfig = game.portal?.evidence;
const evidenceItems =
	evidenceConfig?.items.flatMap((item, index) => {
		const image = resolveGameAsset(item.image, `game.portal.evidence.items[${index}].image`);
		if (!image) return [];
		return { image, alt: item.alt, caption: item.caption, href: item.href };
	}) ?? [];

const showAbout = game.portal?.showAbout !== false;
---

<!-- 01 HERO -->
<section class:list={['exp-home-hero', heroImage && 'exp-home-hero--media']}>
	{heroImage && (
		<div class="exp-home-hero__visual">
			<Image
				src={heroImage}
				alt={game.heroAlt ?? game.name}
				width={616}
				height={353}
				widths={[400, 616]}
				sizes="(max-width: 616px) 100vw, 616px"
				loading="eager"
				decoding="sync"
				fetchpriority="high"
				style={{ objectPosition: heroPosition }}
			/>
		</div>
	)}
	<div class="exp-home-hero__copy">
		<p class="exp-eyebrow exp-home-hero__kicker">{t.gameWikiEyebrow}</p>
		<h1 class="exp-display exp-home-hero__title">{game.hubTitle ?? `${game.name} Guide & Wiki`}</h1>
		<p class="exp-lede exp-home-hero__tagline">{game.tagline}</p>
		<div class="exp-home-hero__actions">
			{primaryCta && (
				<a class="exp-btn exp-btn--primary" href={primaryCta.href}>
					{primaryCta.label}
				</a>
			)}
			{secondaryCta && (
				<a class="exp-btn exp-btn--ghost" href={secondaryCta.href}>
					{secondaryCta.label}
				</a>
			)}
		</div>
	</div>
</section>

<!-- 02 POPULAR QUESTIONS -->
{popularQuestions.length > 0 && (
	<section class="exp-section exp-section--tinted exp-home-questions" aria-labelledby="exp-home-questions-heading">
		<div class="exp-content">
			<p class="exp-eyebrow">{t.popularQuestions}</p>
			<h2 class="exp-h2" id="exp-home-questions-heading">{t.popularQuestions}</h2>
			<p class="exp-lede">{t.popularQuestionsLede}</p>
			<div class="exp-questions">
				{popularQuestions.map((question) => (
					<a class="exp-question" href={question.href}>
						<span class="exp-question__copy">
							<span class="exp-question__title">{question.label}</span>
							{question.context && <span class="exp-question__context">{question.context}</span>}
						</span>
						<span class="exp-question__cta">{t.readGuide}</span>
					</a>
				))}
			</div>
		</div>
	</section>
)}

<!-- 03 STATUS STRIP -->
{statusItems.length > 0 && (
	<dl class="exp-home-status" aria-label={t.gameFacts}>
		{statusItems.map((item) => (
			<div class="exp-home-status__item">
				<dt>{item.label}</dt>
				<dd>{item.value}</dd>
			</div>
		))}
	</dl>
)}

<div class="exp-home-flow">
	<!-- 04 ROUTES / PRIMARY PATH -->
	{routes.length > 1 && <ExperienceRouteShowcase routes={routes} />}

	{singleRoute && (
		<section class="exp-section exp-home-primary-path" aria-labelledby="exp-home-primary-path-heading">
			<div class="exp-content">
				<p class="exp-eyebrow">{t.startHere}</p>
				<h2 class="exp-h2" id="exp-home-primary-path-heading">{singleRoute.title}</h2>
				<p class="exp-lede">{singleRoute.description}</p>
				<div class="exp-primary-path">
					<RouteTopicCard route={singleRoute} number="01" variant="primary" />
					{singleRouteStartGuides.length > 0 && (
						<div class="exp-primary-path__guides" aria-label={t.followTheRoute}>
							{singleRouteStartGuides.map((page) => (
								<a class="exp-primary-guide" href={page.href}>
									<span class="exp-primary-guide__label">{page.eyebrow ?? t.read}</span>
									<span class="exp-primary-guide__title">{page.title}</span>
									<span class="exp-primary-guide__desc">{page.description}</span>
									<span class="exp-primary-guide__arrow" aria-hidden="true">→</span>
								</a>
							))}
						</div>
					)}
				</div>
			</div>
		</section>
	)}

	<!-- 05 START HERE -->
	{!singleRoute && startHere.length > 0 && (
		<>
			<section class="exp-section exp-home-start" aria-labelledby="exp-home-start-heading">
				<div class="exp-content">
					<p class="exp-eyebrow">{t.startHere}</p>
					<h2 class="exp-h2" id="exp-home-start-heading">{t.startHereTitle}</h2>
					<p class="exp-lede">{t.startHereSectionLede}</p>
					<div class="exp-start-list">
						{startHere.map((item) => (
							<a class="exp-start-item" href={item.href}>
								<div class="exp-start-item__copy">
									<span class="exp-start-item__eyebrow">{item.label ?? t.startHere}</span>
									<span class="exp-start-item__title">{item.title}</span>
									<span class="exp-start-item__desc">{item.description}</span>
								</div>
								{item.badge && <span class="exp-badge">{item.badge}</span>}
								<span class="exp-start-item__arrow" aria-hidden="true">→</span>
							</a>
						))}
					</div>
				</div>
			</section>
			<AdSlot slot="content" />
		</>
	)}

	<!-- 06 FEATURED -->
	{featured && (
		<section class:list={['exp-section', 'exp-home-featured', featuredHasCover && 'exp-home-featured--media']} aria-labelledby="exp-home-featured-heading">
			<div class="exp-content">
				<div class="exp-featured-copy">
					<p class="exp-eyebrow">{featuredEyebrow}</p>
					<h2 class="exp-h2" id="exp-home-featured-heading">{featured.data.title}</h2>
					<p class="exp-lede">{featured.data.description}</p>
					<a class="exp-cta-link" href={featuredHref}>{t.readGuide}</a>
				</div>
				{featuredHasCover && featured.data.cover && (
					<div class="exp-featured-media">
						<Image src={featured.data.cover} alt="" width={960} height={540} loading="lazy" />
					</div>
				)}
			</div>
		</section>
	)}

	<!-- 07 FIELD NOTES -->
	{fieldNotes.length > 0 && (
		<section class="exp-section exp-home-notes" aria-labelledby="exp-home-notes-heading">
			<div class="exp-content">
				<p class="exp-eyebrow">{t.fieldNotes}</p>
				<h2 class="exp-h2" id="exp-home-notes-heading">{t.fieldNotes}</h2>
				<div class="exp-note-list">
					{fieldNotes.map((note) => (
						<a class="exp-note" href={guideHref(note)}>
							<span class="exp-note__copy">
								<span class="exp-note__title">{note.data.title}</span>
								{note.data.description && <span class="exp-note__desc">{note.data.description}</span>}
							</span>
							<span class="exp-note__arrow" aria-hidden="true">→</span>
						</a>
					))}
				</div>
				{firstNoteWithCover?.data.cover && (
					<div class="exp-note-media">
						<Image src={firstNoteWithCover.data.cover} alt="" width={960} height={540} loading="lazy" />
					</div>
				)}
			</div>
		</section>
	)}

	<!-- 08 RECENTLY UPDATED -->
	{recentlyUpdated.length > 0 && (
		<section class="exp-section exp-home-recent" aria-labelledby="exp-home-recent-heading">
			<div class="exp-content">
				<p class="exp-eyebrow">{t.recentlyUpdated}</p>
				<h2 class="exp-h2" id="exp-home-recent-heading">{t.recentlyUpdated}</h2>
				<div class="exp-recent-list">
					{recentlyUpdated.map((item) => (
						<a class="exp-recent" href={item.href}>
							<div class="exp-recent__main">
								<span class="exp-recent__title">{item.title}</span>
								{item.changeSummary && <span class="exp-recent__desc">{item.changeSummary}</span>}
							</div>
							<div class="exp-recent__meta">
								{item.tag && <span class="exp-badge">{item.tag}</span>}
								<time datetime={item.date.toISOString()}>{formatUiDate(item.date)}</time>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>
	)}

	<!-- 09 EVIDENCE -->
	{evidenceItems.length > 0 && (
		<section class="exp-section exp-home-evidence" aria-labelledby="exp-home-evidence-heading">
			<div class="exp-content">
				<p class="exp-eyebrow">{t.evidence}</p>
				<h2 class="exp-h2" id="exp-home-evidence-heading">{evidenceConfig?.title ?? t.evidence}</h2>
				{evidenceConfig?.description && <p class="exp-lede">{evidenceConfig.description}</p>}
				<div class="exp-evidence-grid">
					{evidenceItems.map((item) => (
						<figure class="exp-evidence-item">
							{item.href ? (
								<a href={item.href}><Image src={item.image} alt={item.alt} width={960} height={540} loading="lazy" /></a>
							) : (
								<Image src={item.image} alt={item.alt} width={960} height={540} loading="lazy" />
							)}
							{item.caption && <figcaption>{item.caption}</figcaption>}
						</figure>
					))}
				</div>
			</div>
		</section>
	)}

	<!-- 10 ABOUT -->
	{showAbout && (
		<section class="exp-section exp-home-about" id="about" aria-labelledby="exp-home-about-heading">
			<div class="exp-content">
				<p class="exp-eyebrow">{t.about}</p>
				<h2 class="exp-h2" id="exp-home-about-heading">{game.name}</h2>
				<p class="exp-lede">{game.description}</p>
				<dl class="exp-about-facts">
					{formatReleaseFact(game.releaseStatus, game.releaseDate) && (
						<div><dt>{t.release}</dt><dd>{formatReleaseFact(game.releaseStatus, game.releaseDate)}</dd></div>
					)}
					{game.platforms.length > 0 && <div><dt>{t.platforms}</dt><dd>{game.platforms.join(' / ')}</dd></div>}
					{game.developer && <div><dt>{t.developer}</dt><dd>{game.developer}</dd></div>}
					{game.publisher && <div><dt>{t.publisher}</dt><dd>{game.publisher}</dd></div>}
				</dl>
			</div>
		</section>
	)}
</div>
